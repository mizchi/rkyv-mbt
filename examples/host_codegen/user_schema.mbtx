///|
/// A standalone MoonBit script that owns a small source schema and emits the
/// typed archive API consumed by `cmd/host_js`.
enum FieldType {
  UInt32
  Bool
  Text
  UInt32Array
}

///|
struct FieldSpec {
  name : String
  typ : FieldType
}

///|
struct StructSpec {
  name : String
  fields : Array[FieldSpec]
}

///|
fn FieldType::schema_expr(self : FieldType) -> String {
  match self {
    UInt32 => "@rkyv.Schema::U32"
    Bool => "@rkyv.Schema::Bool"
    Text => "@rkyv.Schema::String"
    UInt32Array => "@rkyv.Schema::VecU32"
  }
}

///|
fn FieldType::input_type(self : FieldType) -> String {
  match self {
    UInt32 => "UInt"
    Bool => "Bool"
    Text => "String"
    UInt32Array => "Array[UInt]"
  }
}

///|
fn FieldType::value_expr(self : FieldType, name : String) -> String {
  match self {
    UInt32 => "@rkyv.Value::U32(\{name})"
    Bool => "@rkyv.Value::Bool(\{name})"
    Text => "@rkyv.Value::String(\{name})"
    UInt32Array => "@rkyv.Value::VecU32(\{name})"
  }
}

///|
fn FieldType::view_type(self : FieldType) -> String {
  match self {
    UInt32 => "UInt"
    Bool => "Bool"
    Text => "String"
    UInt32Array => "@rkyv.U32VecView"
  }
}

///|
fn FieldType::view_method(self : FieldType) -> String {
  match self {
    UInt32 => "read_u32"
    Bool => "read_bool"
    Text => "read_string"
    UInt32Array => "read_vec_u32"
  }
}

///|
fn emit_one_arg_header(
  prefix : String,
  argument : String,
  suffix : String,
) -> Unit {
  let signature = "\{prefix}(\{argument})\{suffix}"
  if signature.length() >= 82 {
    println("\{prefix}(")
    println("  \{argument},")
    println(")\{suffix}")
  } else {
    println(signature)
  }
}

///|
fn emit_two_arg_header(
  prefix : String,
  first : String,
  second : String,
  suffix : String,
) -> Unit {
  let signature = "\{prefix}(\{first}, \{second})\{suffix}"
  if signature.length() >= 82 {
    println("\{prefix}(")
    println("  \{first},")
    println("  \{second},")
    println(")\{suffix}")
  } else {
    println(signature)
  }
}

///|
fn emit_getter(spec : StructSpec, field : FieldSpec) -> Unit {
  println("///|")
  println("/// Reads `\{field.name}` from a generated \{spec.name} archive.")
  emit_one_arg_header(
    "pub fn \{spec.name}View::\{field.name}",
    "self : \{spec.name}View",
    " -> \{field.typ.view_type()} raise @rkyv.RkyvError {",
  )
  println("  match self.view.field(\"\{field.name}\") {")
  println("    None => abort(\"generated schema did not expose \{field.name}\")")
  println("    Some(field) =>")
  println("      match field.\{field.typ.view_method()}() {")
  println("        None => abort(\"generated schema type did not match \{field.name}\")")
  println("        Some(value) => value")
  println("      }")
  println("  }")
  println("}")
}

///|
fn emit_fixed_mutator(
  spec : StructSpec,
  field : FieldSpec,
  input_type : String,
  setter : String,
) -> Unit {
  println("///|")
  println("/// Replaces `\{field.name}` without changing the archive layout.")
  emit_two_arg_header(
    "pub fn \{spec.name}MutView::set_\{field.name}",
    "self : \{spec.name}MutView",
    "value : \{input_type}",
    " -> Unit {",
  )
  println("  match self.view.field(\"\{field.name}\") {")
  println("    None => abort(\"generated schema did not expose \{field.name}\")")
  println("    Some(field) =>")
  println("      if field.\{setter}(value) {")
  println("        ()")
  println("      } else {")
  println("        abort(\"generated schema type did not match \{field.name}\")")
  println("      }")
  println("  }")
  println("}")
}

///|
fn emit_mut_accessor(spec : StructSpec, field : FieldSpec) -> Unit {
  match field.typ {
    UInt32 => emit_fixed_mutator(spec, field, "UInt", "set_u32")
    Bool => emit_fixed_mutator(spec, field, "Bool", "set_bool")
    Text => {
      println("///|")
      println("/// Replaces `\{field.name}` only when its UTF-8 byte length is unchanged.")
      emit_two_arg_header(
        "pub fn \{spec.name}MutView::set_\{field.name}_same_length",
        "self : \{spec.name}MutView",
        "value : String",
        " -> Bool raise @rkyv.RkyvError {",
      )
      println("  match self.view.field(\"\{field.name}\") {")
      println("    None => abort(\"generated schema did not expose \{field.name}\")")
      println("    Some(field) => field.set_string(value)")
      println("  }")
      println("}")
    }
    UInt32Array => {
      println("///|")
      println("/// Opens the existing `\{field.name}` elements for in-place replacement.")
      emit_one_arg_header(
        "pub fn \{spec.name}MutView::\{field.name}_mut",
        "self : \{spec.name}MutView",
        " -> @rkyv.MutU32VecView raise @rkyv.RkyvError {",
      )
      println("  match self.view.field(\"\{field.name}\") {")
      println("    None => abort(\"generated schema did not expose \{field.name}\")")
      println("    Some(field) =>")
      println("      match field.vec_u32_mut() {")
      println("        None => abort(\"generated schema type did not match \{field.name}\")")
      println("        Some(view) => view")
      println("      }")
      println("  }")
      println("}")
    }
  }
}

///|
fn emit_schema(spec : StructSpec) -> Unit {
  println("///|")
  println("/// Generated by examples/host_codegen/user_schema.mbtx. Do not edit.")
  println("let schema : @rkyv.Schema = @rkyv.Schema::Struct([")
  for field in spec.fields {
    println(
      "  { name: \"\{field.name}\", schema: \{field.typ.schema_expr()} },",
    )
  }
  println("])" )
  println("")
  println("///|")
  println("/// Encodes \{spec.name} into caller-owned mutable archive bytes.")
  println("pub fn encode(")
  for field in spec.fields {
    println("  \{field.name} : \{field.typ.input_type()},")
  }
  println(") -> Array[Byte] raise @rkyv.SchemaError {")
  println("  schema.encode_mut(")
  println("    @rkyv.Value::Struct([")
  for field in spec.fields {
    println(
      "      { name: \"\{field.name}\", value: \{field.typ.value_expr(field.name)} },",
    )
  }
  println("    ]),")
  println("  )")
  println("}")
  println("")
  println("///|")
  println("/// A typed zero-copy view of a generated \{spec.name} archive.")
  println("pub struct \{spec.name}View {")
  println("  view : @rkyv.View")
  println("}")
  println("")
  println("///|")
  println("/// Validates and opens a generated \{spec.name} archive.")
  emit_one_arg_header(
    "pub fn \{spec.name}View::root",
    "bytes : Bytes",
    " -> \{spec.name}View raise @rkyv.RkyvError {",
  )
  println("  { view: schema.root(bytes) }")
  println("}")
  for field in spec.fields {
    println("")
    emit_getter(spec, field)
  }
  println("")
  println("///|")
  println("/// A typed mutable view of a generated \{spec.name} archive.")
  println("pub struct \{spec.name}MutView {")
  println("  view : @rkyv.MutView")
  println("}")
  println("")
  println("///|")
  println("/// Validates and opens a mutable generated \{spec.name} archive.")
  emit_one_arg_header(
    "pub fn \{spec.name}MutView::root",
    "bytes : MutArrayView[Byte]",
    " -> \{spec.name}MutView raise @rkyv.RkyvError {",
  )
  println("  { view: schema.root_mut(bytes) }")
  println("}")
  for field in spec.fields {
    println("")
    emit_mut_accessor(spec, field)
  }
}

///|
fn main {
  emit_schema({
    name: "User",
    fields: [
      { name: "id", typ: UInt32 },
      { name: "active", typ: Bool },
      { name: "name", typ: Text },
      { name: "scores", typ: UInt32Array },
    ],
  })
}
