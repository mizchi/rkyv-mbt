///|
test "generated UserView validates the root range" {
  match UserView::root(Bytes::new(0)) {
    Ok(_) => fail("empty archive was accepted")
    Err(_) => ()
  }
}

///|
/// This archive is generated by Rust rkyv 0.8.17 from the `User` type in the
/// codegen integration test. The view source is the exact codegen output.
test "generated UserView reads a Rust rkyv struct archive" {
  let archive = Bytes::from_array([
    b'\x07', b'\x00', b'\x00', b'\x00', b'\x0b', b'\x00', b'\x00', b'\x00', b'\x0d',
    b'\x00', b'\x00', b'\x00', b'\x2a', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00',
    b'\x00', b'\x00', b'A', b'd', b'a', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
    b'\xe4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00', b'\x00', b'\x00',
  ])
  match UserView::root(archive) {
    Err(_) => fail("valid Rust User archive was rejected")
    Ok(user) => {
      assert_eq(user.id(), Ok(42U))
      assert_eq(user.active(), Ok(true))
      assert_eq(user.name(), Ok("Ada"))
      match user.scores() {
        Err(_) => fail("valid Rust User scores were rejected")
        Ok(scores) => assert_eq(scores.to_array(), Ok([7U, 11U, 13U]))
      }
    }
  }
}

///|
/// This inline `Account` archive is emitted by Rust rkyv 0.8.17 from the
/// nested `Account { id, profile }` fixture in the codegen integration test.
test "generated nested views read a Rust rkyv struct archive" {
  let archive = Bytes::from_array([
    b'\x63', b'\x00', b'\x00', b'\x00', b'\x21', b'\x00', b'\x00', b'\x00', b'\x01',
    b'\x00', b'\x00', b'\x00',
  ])
  match AccountView::root(archive) {
    Err(_) => fail("valid Rust Account archive was rejected")
    Ok(account) => {
      assert_eq(account.id(), Ok(99U))
      match account.profile() {
        Err(_) => fail("valid Rust Profile archive was rejected")
        Ok(profile) => {
          assert_eq(profile.age(), Ok(33U))
          assert_eq(profile.subscribed(), Ok(true))
        }
      }
    }
  }
}

///|
/// This archive covers `None`, inline `Some(String)`, and `Some(Profile)` in
/// the Rust `Preferences` fixture used by the codegen integration test.
test "generated views read Rust ArchivedOption values" {
  let archive = Bytes::from_array([
    b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x01',
    b'\x00', b'\x00', b'\x00', b'L', b'i', b'n', b'\xff', b'\xff', b'\xff', b'\xff',
    b'\xff', b'\x01', b'\x00', b'\x00', b'\x00', b'\x09', b'\x00', b'\x00', b'\x00',
    b'\x01', b'\x00', b'\x00', b'\x00',
  ])
  match PreferencesView::root(archive) {
    Err(_) => fail("valid Rust Preferences archive was rejected")
    Ok(preferences) => {
      assert_eq(preferences.retries(), Ok(None))
      assert_eq(preferences.nickname(), Ok(Some("Lin")))
      match preferences.profile() {
        Err(_) => fail("valid Rust optional Profile was rejected")
        Ok(None) => fail("Rust Some(Profile) decoded as None")
        Ok(Some(profile)) => {
          assert_eq(profile.age(), Ok(9U))
          assert_eq(profile.subscribed(), Ok(true))
        }
      }
    }
  }
}

///|
/// This archive is emitted by Rust rkyv 0.8.17 from a `Directory` containing
/// two inline `Profile` values. The vector payload precedes its root header.
test "generated views lazily read Rust ArchivedVec nested structs" {
  let archive = Bytes::from_array([
    b'\x04', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00', b'\x00', b'\x00', b'\x09',
    b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\xf0', b'\xff',
    b'\xff', b'\xff', b'\x02', b'\x00', b'\x00', b'\x00',
  ])
  match DirectoryView::root(archive) {
    Err(_) => fail("valid Rust Directory archive was rejected")
    Ok(directory) =>
      match directory.entries() {
        Err(_) => fail("valid Rust Directory entries were rejected")
        Ok(entries) => {
          assert_eq(entries.length(), 2)
          match entries.at(-1) {
            Ok(None) => ()
            _ => fail("negative Directory index was accepted")
          }
          match entries.at(2) {
            Ok(None) => ()
            _ => fail("out-of-bounds Directory index was accepted")
          }
          match entries.at(0) {
            Err(_) => fail("first Rust Profile was rejected")
            Ok(None) => fail("first Rust Profile was missing")
            Ok(Some(profile)) => {
              assert_eq(profile.age(), Ok(4U))
              assert_eq(profile.subscribed(), Ok(true))
            }
          }
          match entries.at(1) {
            Err(_) => fail("second Rust Profile was rejected")
            Ok(None) => fail("second Rust Profile was missing")
            Ok(Some(profile)) => {
              assert_eq(profile.age(), Ok(9U))
              assert_eq(profile.subscribed(), Ok(false))
            }
          }
        }
      }
  }
}
