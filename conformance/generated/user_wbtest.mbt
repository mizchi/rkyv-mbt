///|
test "generated UserView validates the root range" {
  let mut raised = false
  try {
    let _ = UserView::root(Bytes::new(0))
    fail("empty archive was accepted")
  } catch {
    _ => raised = true
  }
  assert_true(raised)
}

///|
/// This archive is generated by Rust rkyv from the codegen integration test.
test "generated UserView reads a Rust rkyv struct archive" {
  let archive = Bytes::from_array([
    b'\x07', b'\x00', b'\x00', b'\x00', b'\x0b', b'\x00', b'\x00', b'\x00', b'\x0d',
    b'\x00', b'\x00', b'\x00', b'\x2a', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00',
    b'\x00', b'\x00', b'A', b'd', b'a', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
    b'\xe4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00', b'\x00', b'\x00',
  ])
  let user = UserView::root(archive)
  assert_eq(user.id(), 42U)
  assert_eq(user.active(), true)
  assert_eq(user.name(), "Ada")
  assert_eq(user.scores().to_array(), [7U, 11U, 13U])
}

///|
test "generated nested views read a Rust rkyv struct archive" {
  let account = AccountView::root(
    Bytes::from_array([
      b'\x63', b'\x00', b'\x00', b'\x00', b'\x21', b'\x00', b'\x00', b'\x00', b'\x01',
      b'\x00', b'\x00', b'\x00',
    ]),
  )
  assert_eq(account.id(), 99U)
  let profile = account.profile()
  assert_eq(profile.age(), 33U)
  assert_eq(profile.subscribed(), true)
}

///|
test "generated views read Rust ArchivedOption values" {
  let preferences = PreferencesView::root(
    Bytes::from_array([
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x01',
      b'\x00', b'\x00', b'\x00', b'L', b'i', b'n', b'\xff', b'\xff', b'\xff', b'\xff',
      b'\xff', b'\x01', b'\x00', b'\x00', b'\x00', b'\x09', b'\x00', b'\x00', b'\x00',
      b'\x01', b'\x00', b'\x00', b'\x00',
    ]),
  )
  assert_eq(preferences.retries(), None)
  assert_eq(preferences.nickname(), Some("Lin"))
  match preferences.profile() {
    None => fail("Rust Some(Profile) decoded as None")
    Some(profile) => {
      assert_eq(profile.age(), 9U)
      assert_eq(profile.subscribed(), true)
    }
  }
}

///|
test "generated views lazily read Rust ArchivedVec nested structs" {
  let directory = DirectoryView::root(
    Bytes::from_array([
      b'\x04', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00', b'\x00', b'\x00', b'\x09',
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\xf0', b'\xff',
      b'\xff', b'\xff', b'\x02', b'\x00', b'\x00', b'\x00',
    ]),
  )
  let entries = directory.entries()
  assert_eq(entries.length(), 2)
  match entries.at(-1) {
    None => ()
    Some(_) => fail("negative Directory index was accepted")
  }
  match entries.at(2) {
    None => ()
    Some(_) => fail("out-of-bounds Directory index was accepted")
  }
  match entries.at(0) {
    None => fail("first Rust Profile was missing")
    Some(profile) => {
      assert_eq(profile.age(), 4U)
      assert_eq(profile.subscribed(), true)
    }
  }
  match entries.at(1) {
    None => fail("second Rust Profile was missing")
    Some(profile) => {
      assert_eq(profile.age(), 9U)
      assert_eq(profile.subscribed(), false)
    }
  }
}
