///|
/// These bytes are a prefix of rkyv-js's Rust-generated rkyv 0.8.14
/// `primitives_basic` conformance fixture. The root is a `u16` at offset 2.
test "reads little-endian primitives from an rkyv archive" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([b'\x2a', b'\xf9', b'\xe8', b'\x03', b'\x18', b'\xfc']),
  )
  assert_eq(reader.read_u8(0), Ok(b'\x2a'))
  assert_eq(reader.read_i8(1), Ok(-7))
  assert_eq(reader.read_u16(2), Ok(1000U))
  assert_eq(reader.read_i16(4), Ok(-1000))
}

///|
/// Exact Rust-generated bytes from rkyv-js's rkyv 0.8.14 conformance suite
/// (`primitives_basic/data.bin`). This guards the default struct alignment as
/// well as the primitive bit-level representation.
test "reads the Rust rkyv 0.8 primitive conformance fixture" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x2a', b'\xf9', b'\xe8', b'\x03', b'\x18', b'\xfc', b'\x00', b'\x00', b'\x15',
      b'\xcd', b'\x5b', b'\x07', b'\xeb', b'\x32', b'\xa4', b'\xf8', b'\x15', b'\x81',
      b'\xe9', b'\x7d', b'\xf4', b'\x10', b'\x22', b'\x11', b'\xeb', b'\x7e', b'\x16',
      b'\x82', b'\x0b', b'\xef', b'\xdd', b'\xee', b'\x00', b'\x00', b'\xc0', b'\x3f',
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
      b'\x00', b'\x02', b'\xc0', b'\x01', b'\x00', b'\x00', b'\x00', b'\x4b', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  assert_eq(reader.root_offset(56), Ok(0))
  assert_eq(reader.read_u32(8), Ok(123456789U))
  assert_eq(reader.read_i32(12), Ok(-123456789))
  assert_eq(reader.read_u64(16), Ok(1234567890123456789UL))
  assert_eq(reader.read_i64(24), Ok(-1234567890123456789L))
  assert_eq(reader.read_bool(48), Ok(true))
  match reader.read_f32(32) {
    Ok(value) => assert_true(value == 1.5)
    Err(_) => fail("rkyv f32 was rejected")
  }
  match reader.read_f64(40) {
    Ok(value) => assert_true(value == -2.25)
    Err(_) => fail("rkyv f64 was rejected")
  }
}

///|
/// rkyv serializes dependencies before the root. This is an `ArchivedVec<u32>`
/// whose elements are `[1, 2, 3]` and whose root header starts at byte 12.
test "resolves an rkyv relative pointer in a Vec header" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x01', b'\x00', b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x03',
      b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  let header = reader.read_vec_header(12)
  match header {
    Ok(header) => {
      assert_eq(header.data_offset, 0)
      assert_eq(header.length, 3)
      assert_eq(reader.read_u32(header.data_offset + 8), Ok(3U))
    }
    Err(_) => fail("valid rkyv Vec header was rejected")
  }
}

///|
/// Generic generated views must validate the whole element span before they
/// retain a data offset. This header points at 12 available bytes, not three
/// 8-byte archived elements.
test "validates an ArchivedVec element span for generated views" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x01', b'\x00', b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x03',
      b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  match reader.read_vec_header_with_element_size(12, 4) {
    Err(_) => fail("valid 4-byte element span was rejected")
    Ok(header) => {
      assert_eq(header.data_offset, 0)
      assert_eq(header.length, 3)
    }
  }
  match reader.read_vec_header_with_element_size(12, 8) {
    Ok(_) => fail("truncated 8-byte element span was accepted")
    Err(_) => ()
  }
}

///|
/// A typed view keeps the archive in place. This is the fast path used by
/// generated bindings that only need a small subset of a large collection.
test "reads an ArchivedVec<u32> lazily and materializes on demand" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x01', b'\x00', b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x03',
      b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  match reader.read_vec_u32(12) {
    Err(_) => fail("valid rkyv Vec<u32> was rejected")
    Ok(view) => {
      assert_eq(view.data_byte_offset(), 0)
      assert_eq(view.length(), 3)
      assert_eq(view.get(0), Some(1U))
      assert_eq(view.get(2), Some(3U))
      assert_eq(view.get(3), None)
      assert_eq(view.at(0), Ok(Some(1U)))
      assert_eq(view.at(2), Ok(Some(3U)))
      assert_eq(view.at(3), Ok(None))
      assert_eq(view.to_array_fast(), [1U, 2U, 3U])
      assert_eq(view.to_array(), Ok([1U, 2U, 3U]))
    }
  }
}

///|
/// The validated view fast path must preserve the reader's selected endian
/// format while avoiding a second range check for every element.
test "reads a validated ArchivedVec<u32> with big-endian elements" {
  let reader = @rkyv.Reader::with_format(
    Bytes::from_array([
      b'\x12', b'\x34', b'\x56', b'\x78', b'\xff', b'\xff', b'\xff', b'\xfc', b'\x00',
      b'\x00', b'\x00', b'\x01',
    ]),
    @rkyv.Format::big_endian(32, true),
  )
  match reader.read_vec_u32(4) {
    Err(_) => fail("valid big-endian Vec<u32> was rejected")
    Ok(view) => {
      assert_eq(view.get(0), Some(0x12345678U))
      assert_eq(view.get(1), None)
      assert_eq(view.at(0), Ok(Some(0x12345678U)))
      assert_eq(view.to_array_fast(), [0x12345678U])
      assert_eq(view.to_array(), Ok([0x12345678U]))
    }
  }
}

///|
/// The SIMD materializer reads four little-endian `u32` values per 128-bit
/// block and finishes a non-multiple-of-four tail with the scalar fast path.
test "materializes an ArchivedVec<u32> with SIMD blocks and a tail" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x01', b'\x00', b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x03',
      b'\x00', b'\x00', b'\x00', b'\x04', b'\x00', b'\x00', b'\x00', b'\x05', b'\x00',
      b'\x00', b'\x00', b'\xec', b'\xff', b'\xff', b'\xff', b'\x05', b'\x00', b'\x00',
      b'\x00',
    ]),
  )
  match reader.read_vec_u32(20) {
    Err(_) => fail("valid five-element Vec<u32> was rejected")
    Ok(view) => {
      assert_eq(view.to_array_fast(), [1U, 2U, 3U, 4U, 5U])
      assert_eq(view.to_array(), Ok([1U, 2U, 3U, 4U, 5U]))
    }
  }
}

///|
/// A native SIMD store writes the destination backing storage as bytes. These
/// non-repeating bit patterns catch an accidental byte/word offset mismatch.
test "materializes full-width u32 SIMD lanes without byte reordering" {
  let expected = [
    0x01020304U, 0x89abcdefU, 0xdeadbeefU, 0x76543210U, 0xfedcba98U,
  ]
  let archive = @rkyv.encode_vec_u32(expected)
  let reader = @rkyv.Reader::new(archive)
  match reader.read_vec_u32(expected.length() * 4) {
    Err(_) => fail("valid Vec<u32> archive was rejected")
    Ok(view) => assert_eq(view.to_array_fast(), expected)
  }
}

///|
/// The view validates the complete element range at construction time so a
/// corrupted length cannot turn a later materialization into an unbounded loop.
test "rejects an ArchivedVec<u32> whose declared elements are truncated" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x08', b'\x00', b'\x00', b'\x00', b'\x03', b'\x00', b'\x00', b'\x00', b'\x01',
      b'\x00', b'\x00', b'\x00',
    ]),
  )
  match reader.read_vec_u32(0) {
    Ok(_) => fail("truncated rkyv Vec<u32> was accepted")
    Err(_) => ()
  }
}

///|
/// ArchivedString uses an 8-byte inline representation on the default
/// pointer-width-32 format and an out-of-line representation for longer text.
test "reads inline and out-of-line ArchivedString values" {
  let inline = @rkyv.Reader::new(
    Bytes::from_array([
      b'm', b'o', b'o', b'n', b'\xff', b'\xff', b'\xff', b'\xff',
    ]),
  )
  assert_eq(inline.read_string(0), Ok("moon"))

  let out_of_line = @rkyv.Reader::new(
    Bytes::from_array([
      b'h', b'e', b'l', b'l', b'o', b' ', b'r', b'k', b'y', b'v', b'\x00', b'\x00',
      b'\x8a', b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff',
    ]),
  )
  assert_eq(out_of_line.root_offset(8), Ok(12))
  assert_eq(out_of_line.read_string(12), Ok("hello rkyv"))
}

///|
/// Exact Rust-generated bytes from rkyv-js's rkyv 0.8.14 `options` fixture.
/// It exercises the tag-plus-padding layout used by `ArchivedOption<T>`.
test "locates Option values in the Rust rkyv conformance fixture" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'a', b'n', b' ', b'o', b'p', b't', b'i', b'o', b'n', b'a', b'l', b' ', b'o',
      b'u', b't', b'-', b'o', b'f', b'-', b'l', b'i', b'n', b'e', b' ', b's', b't',
      b'r', b'i', b'n', b'g', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00', b'\x00', b'\x00', b'\xef',
      b'\xbe', b'\xad', b'\xde', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00', b'\x00',
      b'\x00', b'\x9e', b'\x00', b'\x00', b'\x00', b'\xc0', b'\xff', b'\xff', b'\xff',
      b'\x01', b'\x01', b'\x07', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
    ]),
  )
  assert_eq(reader.root_offset(48), Ok(32))
  assert_eq(reader.read_option_value_offset(32, 4), Ok(None))
  assert_eq(reader.read_option_value_offset(40, 4), Ok(Some(44)))
  assert_eq(reader.read_u32(44), Ok(0xdead_beefU))
  assert_eq(reader.read_option_value_offset(60, 4), Ok(Some(64)))
  assert_eq(reader.read_string(64), Ok("an optional out-of-line string"))
  assert_eq(reader.read_option_value_offset(72, 1), Ok(Some(73)))
  assert_eq(reader.read_option_value_offset(73, 1), Ok(Some(74)))
  assert_eq(reader.read_option_value_offset(75, 1), Ok(None))
}

///|
test "rejects out-of-bounds reads instead of decoding untrusted bytes" {
  let reader = @rkyv.Reader::new(Bytes::new(0))
  match reader.read_u32(0) {
    Ok(_) => fail("out-of-bounds read unexpectedly succeeded")
    Err(_) => ()
  }
}

///|
test "honors an explicitly selected big-endian format" {
  let reader = @rkyv.Reader::with_format(
    Bytes::from_array([b'\x12', b'\x34']),
    @rkyv.Format::big_endian(32, true),
  )
  assert_eq(reader.read_u16(0), Ok(0x1234U))
}

///|
/// Exact root archives from Rust rkyv 0.8.17 with its default format profile.
/// The counterpart Rust test accepts these MoonBit-produced bytes with
/// `rkyv::access`, so this assertion is the Rust -> MoonBit half of the
/// byte-level conformance contract.
test "matches Rust rkyv 0.8.17 Vec and String root archives" {
  let archive = @rkyv.encode_vec_u32([1U, 2U, 3U])
  assert_eq(
    archive,
    Bytes::from_array([
      b'\x01', b'\x00', b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x03',
      b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  assert_eq(
    @rkyv.encode_string("moon"),
    Bytes::from_array([
      b'm', b'o', b'o', b'n', b'\xff', b'\xff', b'\xff', b'\xff',
    ]),
  )
  assert_eq(
    @rkyv.encode_string("hello rkyv"),
    Bytes::from_array([
      b'h', b'e', b'l', b'l', b'o', b' ', b'r', b'k', b'y', b'v', b'\x00', b'\x00',
      b'\x8a', b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff',
    ]),
  )
}
