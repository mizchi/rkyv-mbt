///|
/// These bytes are a prefix of rkyv-js's Rust-generated rkyv 0.8.14
/// `primitives_basic` conformance fixture. The root is a `u16` at offset 2.
test "reads little-endian primitives from an rkyv archive" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([b'\x2a', b'\xf9', b'\xe8', b'\x03', b'\x18', b'\xfc']),
  )
  assert_eq(reader.read_u8(0), b'\x2a')
  assert_eq(reader.read_i8(1), -7)
  assert_eq(reader.read_u16(2), 1000U)
  assert_eq(reader.read_i16(4), -1000)
}

///|
/// Exact Rust-generated bytes from rkyv-js's rkyv 0.8.14 conformance suite.
test "reads the Rust rkyv primitive conformance fixture" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x2a', b'\xf9', b'\xe8', b'\x03', b'\x18', b'\xfc', b'\x00', b'\x00', b'\x15',
      b'\xcd', b'\x5b', b'\x07', b'\xeb', b'\x32', b'\xa4', b'\xf8', b'\x15', b'\x81',
      b'\xe9', b'\x7d', b'\xf4', b'\x10', b'\x22', b'\x11', b'\xeb', b'\x7e', b'\x16',
      b'\x82', b'\x0b', b'\xef', b'\xdd', b'\xee', b'\x00', b'\x00', b'\xc0', b'\x3f',
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
      b'\x00', b'\x02', b'\xc0', b'\x01', b'\x00', b'\x00', b'\x00', b'\x4b', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  assert_eq(reader.root_offset(56), 0)
  assert_eq(reader.read_u32(8), 123456789U)
  assert_eq(reader.read_i32(12), -123456789)
  assert_eq(reader.read_u64(16), 1234567890123456789UL)
  assert_eq(reader.read_i64(24), -1234567890123456789L)
  assert_eq(reader.read_bool(48), true)
  assert_true(reader.read_f32(32) == 1.5)
  assert_true(reader.read_f64(40) == -2.25)
}

///|
/// A typed view validates the full archived span once, then supports lazy
/// access, materialization, fixed storage, and mutable windows without Result.
test "reads and copies an ArchivedVec<u32> through the raise API" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x01', b'\x00', b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x03',
      b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  let header = reader.read_vec_header(12)
  assert_eq(header.data_offset, 0)
  assert_eq(header.length, 3)
  assert_eq(reader.read_vec_u32_length(12), 3)
  let view = reader.read_vec_u32(12)
  assert_eq(view.get(0), Some(1U))
  assert_eq(view.at(2), Some(3U))
  assert_eq(view.at(3), None)
  assert_eq(view.to_array(), [1U, 2U, 3U])
  let destination : FixedArray[UInt] = FixedArray::make(4, 99U)
  assert_eq(reader.read_vec_u32_into(12, destination), 3)
  assert_eq(Array::from_fixed_array(destination), [1U, 2U, 3U, 99U])
  let storage : Array[UInt] = [99U, 99U, 99U, 99U, 99U]
  view.copy_into_mut_view(storage.mut_view(start=1, end=4))
  assert_eq(storage, [99U, 1U, 2U, 3U, 99U])
}

///|
/// Header-only consumers validate the complete element span without retaining
/// the archive as a view.
test "validates an ArchivedVec<u32> length without constructing a view" {
  let truncated = @rkyv.Reader::new(
    Bytes::from_array([
      b'\x08', b'\x00', b'\x00', b'\x00', b'\x03', b'\x00', b'\x00', b'\x00', b'\x01',
      b'\x00', b'\x00', b'\x00',
    ]),
  )
  let mut raised = false
  try {
    let _ = truncated.read_vec_u32_length(0)
    fail("truncated Vec<u32> length was accepted")
  } catch {
    @rkyv.RkyvError::InvalidCollectionLength(length) => {
      assert_eq(length, 3)
      raised = true
    }
    _ => fail("truncated Vec<u32> returned the wrong error")
  }
  assert_true(raised)
}

///|
/// Generated collection views use their Rust-provided archived element size.
test "validates generic ArchivedVec element spans before returning a header" {
  let reader = @rkyv.Reader::new(@rkyv.encode_vec_u32([1U, 2U, 3U]))
  let header = reader.read_vec_header_with_element_size(12, 4)
  assert_eq(header.data_offset, 0)
  assert_eq(header.length, 3)
  let mut raised = false
  try {
    let _ = reader.read_vec_header_with_element_size(12, 8)
    fail("truncated 8-byte element span was accepted")
  } catch {
    @rkyv.RkyvError::InvalidCollectionLength(length) => {
      assert_eq(length, 3)
      raised = true
    }
    _ => fail("generic Vec header returned the wrong error")
  }
  assert_true(raised)
}

///|
/// Short destinations are rejected before writing any elements.
test "keeps short vector destinations unchanged" {
  let reader = @rkyv.Reader::new(@rkyv.encode_vec_u32([1U, 2U, 3U]))
  let view = reader.read_vec_u32(12)
  let too_short : FixedArray[UInt] = FixedArray::make(2, 77U)
  let mut raised = false
  view.copy_into(too_short) catch {
    @rkyv.RkyvError::DestinationTooSmall(required~, actual~) => {
      assert_eq(required, 3)
      assert_eq(actual, 2)
      raised = true
    }
    _ => fail("short destination returned the wrong error")
  }
  assert_true(raised)
  assert_eq(Array::from_fixed_array(too_short), [77U, 77U])
}

///|
/// A short mutable window also fails before it writes any source elements.
test "keeps short MutArrayView destinations unchanged" {
  let reader = @rkyv.Reader::new(@rkyv.encode_vec_u32([1U, 2U, 3U]))
  let view = reader.read_vec_u32(12)
  let storage : Array[UInt] = [77U, 77U, 77U]
  let mut raised = false
  view.copy_into_mut_view(storage.mut_view(end=2)) catch {
    @rkyv.RkyvError::DestinationTooSmall(required~, actual~) => {
      assert_eq(required, 3)
      assert_eq(actual, 2)
      raised = true
    }
    _ => fail("short mutable destination returned the wrong error")
  }
  assert_true(raised)
  assert_eq(storage, [77U, 77U, 77U])
}

///|
/// The generic reader must retain its selected endian format in a typed view.
test "reads a validated ArchivedVec<u32> with big-endian elements" {
  let reader = @rkyv.Reader::with_format(
    Bytes::from_array([
      b'\x12', b'\x34', b'\x56', b'\x78', b'\xff', b'\xff', b'\xff', b'\xfc', b'\x00',
      b'\x00', b'\x00', b'\x01',
    ]),
    @rkyv.Format::big_endian(32, true),
  )
  assert_eq(reader.read_vec_u32_length(4), 1)
  let view = reader.read_vec_u32(4)
  assert_eq(view.get(0), Some(0x12345678U))
  let destination : FixedArray[UInt] = FixedArray::make(1, 0U)
  view.copy_into(destination)
  assert_eq(Array::from_fixed_array(destination), [0x12345678U])
}

///|
/// SIMD materialization must preserve full-width words and handle its tail.
test "materializes full-width u32 SIMD lanes and a tail" {
  let expected = [
    0x01020304U, 0x89abcdefU, 0xdeadbeefU, 0x76543210U, 0xfedcba98U,
  ]
  let reader = @rkyv.Reader::new(@rkyv.encode_vec_u32(expected))
  let view = reader.read_vec_u32(expected.length() * 4)
  assert_eq(view.to_array_fast(), expected)
  assert_eq(Array::from_fixed_array(view.to_fixed_array_fast()), expected)
}

///|
/// Raw fields and application-specific archived blobs can stay borrowed.
test "reads validated archive byte ranges and raises for bounds errors" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([b'\x00', b'\x01', b'\x02', b'\x03', b'\x04']),
  )
  let view = reader.read_bytes_view(1, 3)
  assert_eq(view.length(), 3)
  assert_eq(view[0], b'\x01')
  let mut raised = false
  try {
    let _ = reader.read_bytes_view(3, 3)
    fail("out-of-range bytes were accepted")
  } catch {
    @rkyv.RkyvError::OutOfBounds(offset~, size~, length~) => {
      assert_eq(offset, 3)
      assert_eq(size, 3)
      assert_eq(length, 5)
      raised = true
    }
    _ => fail("out-of-range bytes returned the wrong error")
  }
  assert_true(raised)
}

///|
/// Primitive reads must reject a malformed archive rather than decoding bytes.
test "raises for out-of-bounds primitive reads" {
  let reader = @rkyv.Reader::new(Bytes::new(0))
  let mut raised = false
  try {
    let _ = reader.read_u32(0)
    fail("out-of-bounds primitive read was accepted")
  } catch {
    @rkyv.RkyvError::OutOfBounds(offset~, size~, length~) => {
      assert_eq(offset, 0)
      assert_eq(size, 4)
      assert_eq(length, 0)
      raised = true
    }
    _ => fail("primitive read returned the wrong error")
  }
  assert_true(raised)
}

///|
/// ArchivedString uses an inline representation on the default profile and an
/// out-of-line representation for longer text.
test "reads inline and out-of-line ArchivedString values" {
  let inline = @rkyv.Reader::new(
    Bytes::from_array([
      b'm', b'o', b'o', b'n', b'\xff', b'\xff', b'\xff', b'\xff',
    ]),
  )
  assert_eq(inline.read_string(0), "moon")
  let out_of_line = @rkyv.Reader::new(
    Bytes::from_array([
      b'h', b'e', b'l', b'l', b'o', b' ', b'r', b'k', b'y', b'v', b'\x00', b'\x00',
      b'\x8a', b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff',
    ]),
  )
  assert_eq(out_of_line.root_offset(8), 12)
  assert_eq(out_of_line.read_string(12), "hello rkyv")
}

///|
/// Exact Rust-generated option bytes exercise rkyv's tag-plus-padding layout.
test "locates Option values in the Rust rkyv conformance fixture" {
  let reader = @rkyv.Reader::new(
    Bytes::from_array([
      b'a', b'n', b' ', b'o', b'p', b't', b'i', b'o', b'n', b'a', b'l', b' ', b'o',
      b'u', b't', b'-', b'o', b'f', b'-', b'l', b'i', b'n', b'e', b' ', b's', b't',
      b'r', b'i', b'n', b'g', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00', b'\x00', b'\x00', b'\xef',
      b'\xbe', b'\xad', b'\xde', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
      b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00', b'\x00',
      b'\x00', b'\x9e', b'\x00', b'\x00', b'\x00', b'\xc0', b'\xff', b'\xff', b'\xff',
      b'\x01', b'\x01', b'\x07', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
    ]),
  )
  assert_eq(reader.root_offset(48), 32)
  assert_eq(reader.read_option_value_offset(32, 4), None)
  assert_eq(reader.read_option_value_offset(40, 4), Some(44))
  assert_eq(reader.read_u32(44), 0xdead_beefU)
  assert_eq(reader.read_option_value_offset(60, 4), Some(64))
  assert_eq(reader.read_string(64), "an optional out-of-line string")
}

///|
/// Trusted lazy reads retain rkyv's permissive interpretation, while schema
/// validation must reject invalid discriminants before exposing an archive to
/// an untrusted caller.
test "strict validation rejects invalid bool and Option discriminants" {
  let bool_reader = @rkyv.Reader::new(Bytes::from_array([b'\x02']))
  let mut invalid_bool = false
  try {
    let _ = bool_reader.read_bool_strict(0)
    fail("invalid bool was accepted")
  } catch {
    @rkyv.RkyvError::InvalidBool(value) => {
      assert_eq(value, b'\x02')
      invalid_bool = true
    }
    _ => fail("invalid bool produced the wrong error")
  }
  assert_true(invalid_bool)

  let option_reader = @rkyv.Reader::new(
    Bytes::from_array([b'\x02', b'\x00', b'\x00', b'\x00', b'\x00']),
  )
  let mut invalid_option = false
  try {
    let _ = option_reader.read_option_value_offset_strict(0, 4)
    fail("invalid Option tag was accepted")
  } catch {
    @rkyv.RkyvError::InvalidOptionTag(value) => {
      assert_eq(value, b'\x02')
      invalid_option = true
    }
    _ => fail("invalid Option tag produced the wrong error")
  }
  assert_true(invalid_option)
}

///|
/// Exact root archives from Rust rkyv's default format protect byte-level
/// Rust-to-MoonBit interoperability.
test "matches Rust Vec and String root archives" {
  assert_eq(
    @rkyv.encode_vec_u32([1U, 2U, 3U]),
    Bytes::from_array([
      b'\x01', b'\x00', b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x03',
      b'\x00', b'\x00', b'\x00', b'\xf4', b'\xff', b'\xff', b'\xff', b'\x03', b'\x00',
      b'\x00', b'\x00',
    ]),
  )
  assert_eq(
    @rkyv.encode_string("moon"),
    Bytes::from_array([
      b'm', b'o', b'o', b'n', b'\xff', b'\xff', b'\xff', b'\xff',
    ]),
  )
}
